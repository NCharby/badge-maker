# ============================================================
# SD Platform / Badge Maker — Environment Variable Reference
# ============================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local to source control.
#
# Production secrets go in Hostinger hPanel → Node.js App →
# Environment Variables. Never use .env.production as a
# committed file.
#
# NEXT_PUBLIC_* variables are baked at build time.
# They must be set in hPanel BEFORE deploying.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_INVITE_EXPIRY_HOURS=24

# ── App ───────────────────────────────────────────────────────
# Set to your production domain in hPanel before deploying.
# Used at build time — must be set before npm run build.
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_APP_NAME=BadgeMaker

# ── File Upload ───────────────────────────────────────────────
NEXT_PUBLIC_MAX_FILE_SIZE=5242880
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# ── Storage ───────────────────────────────────────────────────
NEXT_PUBLIC_STORAGE_BUCKET_BADGE_IMAGES=badge-images
NEXT_PUBLIC_STORAGE_BUCKET_WAIVER_DOCUMENTS=waiver-documents

# ── Waiver ────────────────────────────────────────────────────
WAIVER_VERSION=1.0.0
PDF_ACCESS_EXPIRY_HOURS=24

# ── Debug ─────────────────────────────────────────────────────
NEXT_PUBLIC_DEBUG=false

# ── Puppeteer (Docker/production only) ───────────────────────
# Do not set for local dev (bundled Chromium is used).
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ============================================================
# Future Platform Variables
# (uncomment and fill in as each module is built)
# ============================================================

# ── Square (primary payment processor) ───────────────────────
# Set on the EP's platform_users.payment_provider to activate.
# NEXT_PUBLIC_SQUARE_APPLICATION_ID=sandbox-sq0idb-...  # client-side Web Payments SDK
# NEXT_PUBLIC_SQUARE_LOCATION_ID=L...                   # client-side SDK initialization
# SQUARE_ACCESS_TOKEN=EAAAl...
# SQUARE_LOCATION_ID=L...                               # same value as NEXT_PUBLIC_SQUARE_LOCATION_ID
# SQUARE_WEBHOOK_SIGNATURE_KEY=...                      # from Square Developer → Webhooks
# SQUARE_ENVIRONMENT=sandbox                            # 'sandbox' | 'production'

# ── PayPal (backup payment processor) ────────────────────────
# Set on the EP's platform_users.payment_provider to activate.
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=AW...                    # client-side JS SDK
# PAYPAL_CLIENT_SECRET=EP...
# PAYPAL_WEBHOOK_ID=...                                 # from PayPal Developer → Webhooks
# PAYPAL_ENVIRONMENT=sandbox                            # 'sandbox' | 'production'

# ── Odoo (Waiver module — BLOCKER: credentials not yet available)
# ODOO_API_URL=
# ODOO_API_KEY=
# ODOO_DATABASE=
